{
  "author": "Roberto Pintos López",
  "bugs": {
    "url": "https://github.com/hexkit/multi-tenant-auth-service/issues"
  },
  "description": "Application package for the mail service",
  "devDependencies": {
    "@hexkit/typescript-config": "0.2.0",
    "@inversifyjs/foundation-oxfmt-config": "0.2.0",
    "@inversifyjs/foundation-oxlint-config": "0.2.0",
    "@types/node": "26.6.11",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2009",
    "rimraf": "6.1.4",
    "tslib": "2.9.1",
    "typescript": "5.9.3"
  },
  "devEngines": {
    "node": "^24.10.0",
    "pnpm": "^10.13.1"
  },
  "keywords": [
    "node",
    "typescript",
    "mail",
    "application"
  ],
  "license": "MIT",
  "module": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "name": "@multi-tenant-auth-service/mail-application",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexkit/multi-tenant-auth-service.git"
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "rimraf lib",
    "format": "oxfmt --write ./src",
    "lint": "oxlint ./src",
    "prebuild": "pnpm run build:clean"
  },
  "type": "module",
  "version": "0.1.0"
}
