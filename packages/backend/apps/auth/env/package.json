{
  "author": "Roberto Pintos López",
  "bugs": {
    "url": "https://github.com/hexkit/multi-tenant-auth-service/issues"
  },
  "description": "Environment configuration package for the auth service",
  "devDependencies": {
    "@hexkit/typescript-config": "0.2.0",
    "@hexkit/vitest-config": "0.3.0",
    "@inversifyjs/foundation-oxfmt-config": "0.2.0",
    "@inversifyjs/foundation-oxlint-config": "0.2.0",
    "@types/node": "24.10.12",
    "@vitest/coverage-v8": "4.0.18",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "rimraf": "6.1.2",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "dependencies": {
    "@hexkit/dotenv": "0.2.1",
    "envalid": "8.1.1",
    "inversify": "^7.11.0"
  },
  "devEngines": {
    "node": "^24.10.0",
    "pnpm": "^10.13.1"
  },
  "keywords": [
    "node",
    "typescript",
    "environment",
    "configuration",
    "auth"
  ],
  "license": "MIT",
  "module": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "name": "@multi-tenant-auth-service/auth-env",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexkit/multi-tenant-auth-service.git"
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "rimraf lib",
    "format": "oxfmt --write ./src",
    "lint": "oxlint ./src",
    "prebuild": "pnpm run build:clean",
    "test": "vitest run",
    "test:integration": "pnpm run test --project Integration",
    "test:coverage": "pnpm run test:unit --coverage",
    "test:uncommitted": "pnpm run test --changed=HEAD",
    "test:unit": "pnpm run test --project Unit"
  },
  "type": "module",
  "version": "0.1.0"
}
