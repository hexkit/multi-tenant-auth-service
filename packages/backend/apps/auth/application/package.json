{
  "author": "Roberto Pintos López",
  "bugs": {
    "url": "https://github.com/hexkit/multi-tenant-auth-service/issues"
  },
  "description": "Auth application package for the auth service",
  "devDependencies": {
    "@multi-tenant-auth-service/auth-domain": "workspace:*",
    "@hexkit/vitest-config": "0.3.0",
    "@inversifyjs/foundation-oxfmt-config": "0.2.0",
    "@inversifyjs/foundation-oxlint-config": "0.2.0",
    "@inversifyjs/foundation-typescript-config": "0.2.1",
    "@vitest/coverage-v8": "5.1.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2009",
    "rimraf": "6.1.4",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "devEngines": {
    "node": "^24.10.0",
    "pnpm": "^12.21.0"
  },
  "keywords": [
    "node",
    "typescript",
    "auth",
    "application"
  ],
  "license": "MIT",
  "module": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "name": "@multi-tenant-auth-service/auth-application",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexkit/multi-tenant-auth-service.git"
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "rimraf lib",
    "format": "oxfmt --write ./src",
    "lint": "oxlint ./src",
    "prebuild": "pnpm run build:clean",
    "test": "vitest run",
    "test:integration": "pnpm run test --project Integration",
    "test:coverage": "pnpm run test:unit --coverage",
    "test:uncommitted": "pnpm run test --changed=HEAD",
    "test:unit": "pnpm run test --project Unit"
  },
  "type": "module",
  "version": "0.1.0"
}
