{
  "name": "root",
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/prompt-cli": "21.2.4",
    "@hexkit/instructions": "~0.4.0",
    "@inversifyjs/foundation-changelog-generator": "0.2.2",
    "@multi-tenant-auth-service/scripts": "workspace:*",
    "husky": "9.1.7",
    "knip": "6.48.0",
    "lint-staged": "17.6.2",
    "turbo": "2.11.13"
  },
  "scripts": {
    "build": "turbo run build",
    "commit": "commit",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "prepare": "husky && turbo telemetry disable",
    "prerelease": "pnpm run build",
    "preserve": "./docker/scripts/bootstrap",
    "release": "changeset publish",
    "serve": "trap '' INT TERM; turbo run serve",
    "test:integration": "turbo test:integration",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:uncommitted": "turbo run test:uncommitted --filter [HEAD]",
    "test:unit": "turbo run test:unit",
    "unused": "knip"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "private": true
}
